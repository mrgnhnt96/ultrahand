  "semantic": {
    "color": {
      "$type": "color",
      "surface": {
        "$value": "{primitive.color.sand.98}",
        "$extensions": {
          "ultrahand": {
            "dark": "{primitive.color.sand.6}"
          }
        }
      },
      "surface-raised": {
        "$value": "{primitive.color.sand.100}",
        "$extensions": {
          "ultrahand": {
            "dark": "{primitive.color.sand.15}"
          }
        }
      },
      "on-surface": {
        "$value": "{primitive.color.sand.10}",
        "$extensions": {
          "ultrahand": {
            "dark": "{primitive.color.sand.90}"
          }
        }
      },
      "on-surface-variant": {
        "$value": "{primitive.color.sand.30}",
        "$extensions": {
          "ultrahand": {
            "dark": "{primitive.color.sand.80}"
          }
        }
      },
      "outline": {
        "$value": "{primitive.color.sand.50}",
        "$extensions": {
          "ultrahand": {
            "dark": "{primitive.color.sand.60}"
          }
        }
      },
      "primary": {
        "$value": "{primitive.color.clay.40}",
        "$extensions": {
          "ultrahand": {
            "dark": "{primitive.color.clay.80}"
          }
