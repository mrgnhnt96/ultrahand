          "ultrahand": {
            "dark": "{primitive.color.clay.30}"
          }
        }
      },
      "on-primary-container": {
        "$value": "{primitive.color.clay.10}",
        "$extensions": {
          "ultrahand": {
            "dark": "{primitive.color.clay.90}"
          }
        }
      },
      "error": {
        "$value": "{primitive.color.brick.40}",
        "$extensions": {
          "ultrahand": {
            "dark": "{primitive.color.brick.80}"
          }
        }
      },
      "on-error": {
        "$value": "{primitive.color.sand.100}",
        "$extensions": {
          "ultrahand": {
            "dark": "{primitive.color.brick.20}"
          }
        }
      },
      "success": {
        "$value": "{primitive.color.moss.40}",
        "$extensions": {
          "ultrahand": {
            "dark": "{primitive.color.moss.80}"
          }
        }
      },
      "warning": {
        "$value": "{primitive.color.ochre.40}",
        "$extensions": {
          "ultrahand": {
            "dark": "{primitive.color.ochre.80}"
          }
        }
      },
      "focus-ring": {
        "$value": "{primitive.color.clay.50}",
        "$extensions": {
          "ultrahand": {
            "dark": "{primitive.color.clay.80}"
          }
        }
      }
    },
    "space": {
      "$type": "dimension",
      "inset-tight": {
        "$value": "{primitive.space.2}"
      },
      "inset": {
        "$value": "{primitive.space.4}"
      },
      "inset-loose": {
        "$value": "{primitive.space.6}"
      },
      "gap-related": {
        "$value": "{primitive.space.2}"
      },
      "gap-group": {
        "$value": "{primitive.space.4}"
      },
      "gap-section": {
        "$value": "{primitive.space.8}"
      }
    },
    "radius": {
      "$type": "dimension",
      "control": {
        "$value": "{primitive.radius.sm}"
      },
      "container": {
        "$value": "{primitive.radius.md}"
      },
      "pill": {
        "$value": "{primitive.radius.full}"
      }
    },
    "focus": {
      "$type": "dimension",
      "width": {
        "$value": "{primitive.border.width.thick}"
      },
      "offset": {
        "$value": "{primitive.border.width.thick}"
      }
    },
    "motion": {
      "duration-feedback": {
        "$type": "duration",
        "$value": "{primitive.duration.short}"
      },
      "duration-move": {
        "$type": "duration",
        "$value": "{primitive.duration.medium}"
      },
      "easing": {
        "$type": "cubicBezier",
        "$value": "{primitive.easing.standard}"
      }
    },
    "type": {
      "$type": "typography",
      "headline": {
        "$value": {
          "fontFamily": "{primitive.font.family.serif}",
          "fontSize": "{primitive.font.size.32}",
          "fontWeight": "{primitive.font.weight.medium}",
          "letterSpacing": {
            "value": 0,
            "unit": "px"
          },
          "lineHeight": 1.25
        }
      },
      "title": {
        "$value": {
          "fontFamily": "{primitive.font.family.serif}",
          "fontSize": "{primitive.font.size.20}",
          "fontWeight": "{primitive.font.weight.medium}",
          "letterSpacing": {
            "value": 0,
            "unit": "px"
          },
          "lineHeight": 1.4
        }
      },
      "body": {
        "$value": {
          "fontFamily": "{primitive.font.family.sans}",
          "fontSize": "{primitive.font.size.16}",
          "fontWeight": "{primitive.font.weight.regular}",
          "letterSpacing": {
            "value": 0,
            "unit": "px"
          },
          "lineHeight": 1.5
        }
      },
      "label": {
        "$value": {
          "fontFamily": "{primitive.font.family.sans}",
          "fontSize": "{primitive.font.size.14}",
          "fontWeight": "{primitive.font.weight.medium}",
          "letterSpacing": {
            "value": 0,
            "unit": "px"
          },
          "lineHeight": 1.43
        }
      }
    }
  },
  "component": {
    "button": {
      "primary-bg": {
        "$type": "color",
        "$value": "{semantic.color.primary}"
      },
      "primary-fg": {
        "$type": "color",
        "$value": "{semantic.color.on-primary}"
      },
      "radius": {
        "$type": "dimension",
        "$value": "{semantic.radius.control}"
      },
      "padding-x": {
        "$type": "dimension",
        "$value": "{semantic.space.inset}"
      }
    },
    "card": {
      "bg": {
        "$type": "color",
        "$value": "{semantic.color.surface-raised}"
      },
      "radius": {
        "$type": "dimension",
        "$value": "{semantic.radius.container}"
      },
      "padding": {
        "$type": "dimension",
        "$value": "{semantic.space.inset}"
      }
    }
  }
